# Copy this file to .env; .env is ignored by Git.
# Explicit process environment variables override these values.

# SQLite
SERVICE_AGENT_DB_PATH=data/service_agent.db
SERVICE_AGENT_SQLITE_TIMEOUT_SECONDS=5
SERVICE_AGENT_SQLITE_BUSY_TIMEOUT_MS=5000

# Logging and structured tracing
SERVICE_AGENT_LOG_LEVEL=INFO
SERVICE_AGENT_LOG_JSON=true
SERVICE_AGENT_TRACE_ENABLED=true

# FastAPI and local HTTP client
SERVICE_AGENT_API_HOST=127.0.0.1
SERVICE_AGENT_API_PORT=8000
SERVICE_AGENT_API_RELOAD=false
SERVICE_AGENT_API_URL=http://127.0.0.1:8000
SERVICE_AGENT_API_REQUEST_TIMEOUT_SECONDS=20

# Streamlit
SERVICE_AGENT_UI_HOST=127.0.0.1
SERVICE_AGENT_UI_PORT=8501
SERVICE_AGENT_UI_HEADLESS=true
SERVICE_AGENT_UI_PAGE_TITLE=FDE Servicing Agent Demo
SERVICE_AGENT_UI_PAGE_ICON=⚡
SERVICE_AGENT_UI_LAYOUT=wide
SERVICE_AGENT_UI_GATHER_USAGE_STATS=false
SERVICE_AGENT_UI_API_READ_TIMEOUT_SECONDS=240

# Optional local Ollama generation through its OpenAI-compatible API
SERVICE_AGENT_LLM_PROVIDER=openai_compatible
SERVICE_AGENT_LLM_API_KEY=ollama
SERVICE_AGENT_LLM_MODEL=qwen3:4b-instruct
SERVICE_AGENT_LLM_API_BASE=http://localhost:11434/v1
SERVICE_AGENT_LLM_TIMEOUT_SECONDS=120
SERVICE_AGENT_LLM_TEMPERATURE=0
SERVICE_AGENT_LLM_MAX_TOKENS=512
SERVICE_AGENT_LLM_REASONING_EFFORT=none

# Local lexical, semantic, and hybrid retrieval
RETRIEVAL_MODE=lexical
RETRIEVAL_MODEL=sentence-transformers/all-MiniLM-L6-v2
RETRIEVAL_CACHE_DIR=data/embedding_cache
RETRIEVAL_TOP_K=5
RETRIEVAL_RRF_K=60
RETRIEVAL_SEMANTIC_MIN_SCORE=0.25
RETRIEVAL_SEMANTIC_MIN_TOP_SCORE=0.45

# Customer-history evidence
HISTORY_BACKEND=mock
HISTORY_ANSWER_RECORD_LIMIT=3
HISTORY_LLM_RECORD_LIMIT=5

# Optional read-only Snowflake RSA key-pair authentication
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_ROLE=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=
SNOWFLAKE_PRIVATE_KEY_FILE=C:/Users/your-user/.snowflake/keys/servicing_agent_key.p8
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=
SNOWFLAKE_LOGIN_TIMEOUT_SECONDS=20
SNOWFLAKE_NETWORK_TIMEOUT_SECONDS=30
SNOWFLAKE_QUERY_TIMEOUT_SECONDS=20
SNOWFLAKE_HISTORY_ROW_LIMIT=25
SNOWFLAKE_QUERY_TAG=fde_servicing_agent_history_read
SNOWFLAKE_APPLICATION=FDE_SERVICING_AGENT_POC

# Deterministic SLA rules
SLA_BACKUP_AFTER_MINUTES=15

# Repeatable evaluation and dashboard
EVALUATION_DATASET_PATH=evaluations/golden_questions.json
EVALUATION_RESULTS_PATH=evaluations/latest_results.json
EVALUATION_MODES=lexical,semantic,hybrid
EVALUATION_RUNS=3
EVALUATION_USE_CONFIGURED_LLM=false
EVALUATION_LOG_LEVEL=WARNING
EVALUATION_AS_OF_DATE=2026-11-07
EVALUATION_CLOCK_UTC=2026-11-08T12:00:00Z

# Model cache/offline behavior and opt-in network integration test
HF_HUB_OFFLINE=0
TRANSFORMERS_OFFLINE=0
RUN_SNOWFLAKE_INTEGRATION=false
RUN_OLLAMA_INTEGRATION=false
